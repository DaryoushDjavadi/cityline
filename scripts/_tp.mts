import { chromium, type Page } from "playwright";
const BASE = "http://127.0.0.1:8787";
type E2E = Record<string, (...args: any[]) => any>;
const e2e = <T = any>(page: Page, name: string, ...args: unknown[]) =>
  page.evaluate(({ name, args }) => ((window as any).__citylineE2E[name] as (...a: unknown[]) => unknown)(...args), { name, args }) as Promise<T>;
const pk = <T = any>(page: Page, name: string, ...args: unknown[]) =>
  page.evaluate(({ name, args }) => ((window as any).__citylineE2E.parkUi() as any)[name](...args), { name, args }) as Promise<T>;
const P = (x: number, y: number) => y * 40 + x;
const browser = await chromium.launch({ args: ["--use-gl=angle", "--ignore-gpu-blocklist"] });
const page = await browser.newPage({ viewport: { width: 1280, height: 800 } });
page.on("pageerror", (err) => console.log("pageerror:", String(err)));
page.on("console", (msg) => { if (msg.type() === "error") console.log("console:", msg.text()); });
await page.addInitScript({ content: "window.__name = (fn) => fn;" });
await page.goto(`${BASE}/?e2e=1&gfx=high`, { waitUntil: "networkidle" });
const gate = page.locator("#name-gate");
if (await gate.isVisible().catch(() => false)) { await page.locator("#gate-name").fill("Daryoush"); await page.locator("#gate-enter").click(); }
await page.locator("#lobby-create > summary").click().catch(() => undefined);
await page.locator("#map-seed").fill("1842");
await page.locator("#solo-new").click();
await page.locator("#lobby").waitFor({ state: "hidden", timeout: 20_000 });
await page.waitForFunction(() => Boolean((window as any).__cityline?.ready), undefined, { timeout: 40_000 });
await e2e(page, "showcase", 10);
await e2e(page, "dismissUi");
const area = await e2e(page, "findArea", 3, 2);
const idx = (x: number, y: number) => e2e<number>(page, "cellIndex", x, y);
const road = [await idx(area.x, area.y + 1), await idx(area.x + 1, area.y + 1), await idx(area.x + 2, area.y + 1)];
await e2e(page, "apply", { type: "road", cells: road });
const cell = await idx(area.x + 1, area.y);
console.log(await e2e(page, "apply", { type: "service", index: cell, kind: 20 }));
await e2e(page, "advanceZoo", 4);
await e2e(page, "lookAt", area.x + 1, area.y, 24, 0.9, 0, 0.5);
await page.waitForTimeout(800);
await page.screenshot({ path: "/tmp/tp/city.png" });
await e2e(page, "openHabitat", cell);
await page.waitForTimeout(300);
await page.screenshot({ path: "/tmp/tp/gate.png" });
await page.locator(".pk-enter").click();
await page.waitForTimeout(500);
const run = (zoo: any) => e2e(page, "apply", { type: "zoo", zoo });
await run({ op: "pbuild", kind: "path", cells: Array.from({ length: 30 }, (_, k) => P(20, 4 + k)) });
await run({ op: "pbuild", kind: "path", cells: Array.from({ length: 30 }, (_, k) => P(5 + k, 20)) });
const hab = [["savanne", P(15, 33)], ["wald", P(21, 33)], ["wasser", P(15, 27)], ["polar", P(21, 27)], ["wiese", P(15, 14)], ["savanne", P(21, 14)]];
for (const [kind, c] of hab) console.log(kind, (await run({ op: "pbuild", kind, cells: [c] })).ok);
for (const [kind, t] of [["food", P(19, 38)], ["drink", P(21, 38)], ["souvenir", P(19, 32)], ["toilet", P(21, 32)], ["bench", P(19, 21)], ["bench", P(21, 21)], ["bin", P(19, 19)], ["food", P(10, 21)], ["drink", P(10, 19)], ["bench", P(12, 21)]] as const) await run({ op: "pbuild", kind, cells: [t] });
await run({ op: "pbuild", kind: "tree", cells: [P(8, 22), P(11, 23), P(28, 22), P(30, 18), P(27, 17), P(13, 18), P(26, 23), P(3, 35), P(5, 30), P(34, 34), P(36, 30)] });
await run({ op: "pbuild", kind: "flowers", cells: [P(18, 38), P(22, 38), P(19, 26), P(21, 26), P(6, 21), P(33, 19)] });
const buy = (c: number, species: string) => run({ op: "buy", cell: c, species, origin: "breeder" });
await buy(P(15, 33), "giraffe"); await buy(P(15, 33), "zebra"); await buy(P(15, 33), "zebra");
await buy(P(21, 33), "monkey"); await buy(P(21, 33), "redpanda");
await buy(P(15, 27), "flamingo"); await buy(P(15, 27), "otter"); await buy(P(15, 27), "seal");
await buy(P(21, 27), "penguin"); await buy(P(21, 27), "penguin");
await buy(P(15, 14), "goat"); await buy(P(15, 14), "alpaca"); await buy(P(15, 14), "rabbit");
await buy(P(21, 14), "elephant"); await buy(P(21, 14), "kangaroo");
await e2e(page, "advanceZoo", 40);
const z = await e2e(page, "zoo");
console.log("visitors", z.visitors, "sat", z.satisfaction, "income", z.income, "sales", z.sales);
await pk(page, "leave"); await page.waitForTimeout(300); await pk(page, "enter"); await page.waitForTimeout(4000);
console.log(JSON.stringify(await pk(page, "stats")));
await page.screenshot({ path: "/tmp/tp/park.png" });
await pk(page, "lookAtWorld", 0, 26, 30, 0.5);
await page.waitForTimeout(1500);
await page.screenshot({ path: "/tmp/tp/close.png" });
await pk(page, "toggleStats", true);
await pk(page, "setTab", "stands");
await pk(page, "setTool", "food");
await page.waitForTimeout(300);
await page.screenshot({ path: "/tmp/tp/stats.png" });
await browser.close();
