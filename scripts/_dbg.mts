import { chromium } from "playwright";
const browser = await chromium.launch({ args: ["--use-gl=angle", "--ignore-gpu-blocklist"] });
const page = await browser.newPage({ viewport: { width: 1280, height: 800 } });
page.on("console", (m) => console.log("console:", m.text()));
page.on("pageerror", (e) => console.log("pageerror:", String(e)));
await page.addInitScript({ content: "window.__name = (fn) => fn;" });
await page.goto("http://127.0.0.1:8787/?e2e=1&gfx=high", { waitUntil: "networkidle" });
if (await page.locator("#name-gate").isVisible().catch(() => false)) { await page.locator("#gate-name").fill("Daryoush"); await page.locator("#gate-enter").click(); await page.locator("#name-gate").waitFor({ state: "hidden" }); }
await page.locator("#lobby-create > summary").click().catch(() => undefined);
await page.locator("#solo-new").click();
await page.locator("#lobby").waitFor({ state: "hidden", timeout: 20000 });
await page.waitForFunction(() => Boolean((window as any).__cityline?.ready), undefined, { timeout: 40000 });
const r = await page.evaluate(async () => {
  const e = (window as any).__citylineE2E;
  e.showcase(10);
  const area = e.findArea(3, 2);
  e.apply({ type: "road", cells: [e.cellIndex(area.x, area.y + 1), e.cellIndex(area.x + 1, area.y + 1), e.cellIndex(area.x + 2, area.y + 1)] });
  e.apply({ type: "service", index: e.cellIndex(area.x + 1, area.y), kind: 20 });
  e.advanceZoo(2);
  const P = (x: number, y: number) => y * 40 + x;
  const cells = []; for (let y = 4; y <= 33; y++) cells.push(P(20, y));
  e.apply({ type: "zoo", zoo: { op: "pbuild", kind: "path", cells } });
  e.apply({ type: "zoo", zoo: { op: "pbuild", kind: "savanne", cells: [P(15, 33)] } });
  const z = e.zoo();
  e.parkUi().enter();
  e.parkUi().openHabitat(P(15, 33));
  e.zooUi().setBuilding(true);
  e.zooUi().setTool("shelter");
  const res: any = { habitats: z.habitats.map((h: any) => h.cell), build: e.zooUi().build(), funds: e.state ? 0 : 0 };
  e.zooUi().buildAt(2, 5);
  res.items = e.zoo().habitats[0]?.items;
  return res;
});
console.log(JSON.stringify(r));
await page.waitForTimeout(2000);
const s = await page.evaluate(() => (window as any).__citylineE2E.parkUi().spotScreen(2, 5));
console.log("spot", JSON.stringify(s));
await page.mouse.move(s.x, s.y);
await page.waitForTimeout(500);
await page.screenshot({ path: "/tmp/dbg.png" });
await browser.close();
