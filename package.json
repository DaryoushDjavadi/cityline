{
  "name": "cityline",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,yellow \"npm run dev -w cityline-client\" \"npm run dev -w cityline-server\"",
    "typecheck": "npm run typecheck -w cityline-client && npm run typecheck -w cityline-server",
    "smoke": "tsx scripts/smoke.ts",
    "sim-tests": "tsx scripts/sim-tests.ts",
    "look-shots": "tsx scripts/look-shots.ts",
    "build": "npm run build -w cityline-client",
    "start": "npm run start -w cityline-server",
    "progress-tests": "tsx scripts/progress-tests.ts",
    "perf-probe": "tsx scripts/perf-probe.ts",
    "audio-tests": "tsx scripts/audio-tests.ts",
    "life-playtest": "tsx scripts/life-playtest.mts"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15"
  }
}
